{"info":{"name":"Ball Ranks API","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json","description":"Read-only fantasy basketball and football rankings and projections. Requests start anonymously with Model Zero. For account access, set api_key and change this collection's Authorization to Bearer Token with {{api_key}} as the token. Choose a published football week before sending weekly requests. Documentation: https://ballranks.com/developers"},"auth":{"type":"noauth"},"variable":[{"key":"base_url","value":"https://ballranks.com"},{"key":"api_key","value":""},{"key":"model","value":"v0"},{"key":"week","value":"1"},{"key":"basketball_player","value":"victor-wembanyama"},{"key":"football_player","value":"josh-allen"}],"item":[{"name":"Basketball","item":[{"name":"Get season rankings","request":{"method":"GET","description":"Returns a fantasy basketball or football season ranking board.","url":{"raw":"{{base_url}}/api/v1/rankings/season?sport=basketball&model={{model}}&limit=5","host":["{{base_url}}"],"path":["api","v1","rankings","season"],"query":[{"key":"sport","value":"basketball"},{"key":"model","value":"{{model}}"},{"key":"limit","value":"5"}]}}},{"name":"Get a player's season ranking","request":{"method":"GET","description":"Returns one player's published season ranking by player ID or slug.","url":{"raw":"{{base_url}}/api/v1/players/{{basketball_player}}/rankings?sport=basketball&model={{model}}","host":["{{base_url}}"],"path":["api","v1","players","{{basketball_player}}","rankings"],"query":[{"key":"sport","value":"basketball"},{"key":"model","value":"{{model}}"}]}}},{"name":"Get a player's projection (season)","request":{"method":"GET","description":"Returns one player's season projection, or a weekly football projection.","url":{"raw":"{{base_url}}/api/v1/players/{{basketball_player}}/projections?sport=basketball&scope=season&model={{model}}","host":["{{base_url}}"],"path":["api","v1","players","{{basketball_player}}","projections"],"query":[{"key":"sport","value":"basketball"},{"key":"scope","value":"season"},{"key":"model","value":"{{model}}"}]}}}]},{"name":"Football","item":[{"name":"Get weekly football rankings","request":{"method":"GET","description":"Returns weekly fantasy football rankings for one position and scoring format.","url":{"raw":"{{base_url}}/api/v1/rankings/weekly?sport=football&week={{week}}&position=RB&scoring_format=ppr&model={{model}}&limit=5","host":["{{base_url}}"],"path":["api","v1","rankings","weekly"],"query":[{"key":"sport","value":"football"},{"key":"week","value":"{{week}}"},{"key":"position","value":"RB"},{"key":"scoring_format","value":"ppr"},{"key":"model","value":"{{model}}"},{"key":"limit","value":"5"}]}}},{"name":"Get season rankings","request":{"method":"GET","description":"Returns a fantasy basketball or football season ranking board.","url":{"raw":"{{base_url}}/api/v1/rankings/season?sport=football&scoring_format=ppr&model={{model}}&limit=5","host":["{{base_url}}"],"path":["api","v1","rankings","season"],"query":[{"key":"sport","value":"football"},{"key":"scoring_format","value":"ppr"},{"key":"model","value":"{{model}}"},{"key":"limit","value":"5"}]}}},{"name":"Get a player's season ranking","request":{"method":"GET","description":"Returns one player's published season ranking by player ID or slug.","url":{"raw":"{{base_url}}/api/v1/players/{{football_player}}/rankings?sport=football&scoring_format=ppr&model={{model}}","host":["{{base_url}}"],"path":["api","v1","players","{{football_player}}","rankings"],"query":[{"key":"sport","value":"football"},{"key":"scoring_format","value":"ppr"},{"key":"model","value":"{{model}}"}]}}},{"name":"Get a player's projection (season)","request":{"method":"GET","description":"Returns one player's season projection, or a weekly football projection.","url":{"raw":"{{base_url}}/api/v1/players/{{football_player}}/projections?sport=football&scope=season&scoring_format=ppr&model={{model}}","host":["{{base_url}}"],"path":["api","v1","players","{{football_player}}","projections"],"query":[{"key":"sport","value":"football"},{"key":"scope","value":"season"},{"key":"scoring_format","value":"ppr"},{"key":"model","value":"{{model}}"}]}}},{"name":"Get a player's projection (weekly)","request":{"method":"GET","description":"Returns one player's season projection, or a weekly football projection.","url":{"raw":"{{base_url}}/api/v1/players/{{football_player}}/projections?sport=football&scope=weekly&week={{week}}&scoring_format=ppr&model={{model}}","host":["{{base_url}}"],"path":["api","v1","players","{{football_player}}","projections"],"query":[{"key":"sport","value":"football"},{"key":"scope","value":"weekly"},{"key":"week","value":"{{week}}"},{"key":"scoring_format","value":"ppr"},{"key":"model","value":"{{model}}"}]}}}]}]}